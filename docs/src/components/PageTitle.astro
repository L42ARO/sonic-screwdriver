---
// Starlight's page title, plus a button that copies the page as Markdown (for pasting
// into an AI assistant). The Markdown copies are written next to the pages at build time
// by scripts/markdown-copies.mjs: /docs/agent/ -> /docs/agent.md, /docs/ -> /docs/index.md.
import Default from '@astrojs/starlight/components/PageTitle.astro';

const id = Astro.locals.starlightRoute.entry.id;
const markdownUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${id === 'index' ? 'index' : id}.md`;
---

<div class="page-title-row">
	<Default />
	<button class="copy-markdown" type="button" data-markdown={markdownUrl} title="Copy this page as Markdown, for an AI assistant">
		Copy page
	</button>
</div>

<script>
	document.querySelectorAll<HTMLButtonElement>('.copy-markdown').forEach((button) => {
		button.addEventListener('click', async () => {
			const label = button.textContent;
			try {
				const text = await (await fetch(button.dataset.markdown!)).text();
				await navigator.clipboard.writeText(text);
				button.textContent = 'Copied';
			} catch {
				button.textContent = 'Could not copy';
			}
			setTimeout(() => (button.textContent = label), 1500);
		});
	});
</script>
