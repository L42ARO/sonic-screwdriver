# Copy to .env next to compose.yaml, then run docker compose up (see README).
OPENAI_KEY=
SONIC_MODEL=gpt-6-luna
SONIC_BUDGET_USD=3.00
# Dashboard password for the owner (at least 10 characters). Used only while no password
# is set; change it later in the dashboard.
SONIC_OWNER_PASSWORD=
# How people reach this server; sign-in links use it.
# SONIC_PUBLIC_URL=http://my-server:6080
